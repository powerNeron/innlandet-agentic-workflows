# Placeholder only. Never put real credentials in this tracked file.
# Reference only: the application reads process environment variables, not .env files.
# Never put a real credential in this tracked file.
# Default local model; no model is downloaded automatically.
HAMAR_OLLAMA_MODEL=llama3.2:3b
# Optional exact additional local tags, comma-separated. Empty means default only.
HAMAR_OLLAMA_ALLOWED_MODELS=
# OpenAI stays unavailable unless both flags are explicitly true and a model/key exist.
HAMAR_OPENAI_ENABLED=false
HAMAR_OPENAI_PRIVACY_AUTHORIZED=false
HAMAR_OPENAI_MODEL=
HAMAR_OPENAI_TIMEOUT=20
HAMAR_OPENAI_MAX_OUTPUT_TOKENS=512
OPENAI_API_KEY=
