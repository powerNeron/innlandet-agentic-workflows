{
  "source": {
    "id": "hamar-drikkevann",
    "title": "Vann: offentlig drikkevann i Hamar",
    "paragraphs": [
      {
        "id": "p1",
        "text": "Du skal normalt ha et vanntrykk i tilknytningspunktet til kommunal ledning på mellom 2 og 9 bar."
      },
      {
        "id": "p2",
        "text": "Du skal bli varslet så raskt som mulig dersom det skjer et akutt bortfall av vann."
      },
      {
        "id": "p3",
        "text": "Du kan forvente at et eventuelt avbrudd i vannforsyningen normalt ikke vil vare mer enn 8 timer."
      },
      {
        "id": "p4",
        "text": "Du skal melde fra til kommunen dersom det oppstår feil på vannforsyningen."
      },
      {
        "id": "p5",
        "text": "Du skal lese av vannmåleren ved årsskiftet – med mindre du har fått installert digital vannmåler."
      }
    ],
    "synthetic": false,
    "url": "https://www.hamar.kommune.no/drikkevann/"
  },
